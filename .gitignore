# ============================================
# ZORIN Car Wash — .gitignore
# ============================================

# --- Environment ---
.env
.env.local
.env.*
!.env.example
!**/.env.example

# --- Node / Next.js ---
node_modules/
.next/
.next-runtime/
.next-runtime-v2/
dist/
build/

# --- Python ---
.venv-ocr/
venv/
__pycache__/
*.pyc

# --- Data (runtime, not in repo) ---
/data/
/data-backups/
/src/data/
/temp/
/public/reports/*
!/public/reports/.gitkeep

# --- Build artifacts ---
*.tsbuildinfo
backend-go/server
backend-go/server.exe

# --- Logs ---
*.log

# --- IDE ---
.vscode/
.idea/
.gradle/
local.properties

# --- Claude Code (runtime-мусор, не коммитим) ---
# settings.json (allowlist разрешений) и launch.json (dev-серверы) — КОММИТИМ, они полезны команде.
# Ниже — только эфемерное состояние текущей сессии.
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/plans/
.claude/shell-snapshots/
.claude/todos/

# --- OS ---
.DS_Store
Thumbs.db

# --- USB installer (local only) ---
/ZORIN-USB/

# --- Бэкапы сторонних инструментов ---
.codex-backup/
