# Включение бота: `true` — бот работает, `false` — процесс завершается без ошибок.
TELEGRAM_BOT_ENABLED=false

# Токен Telegram-бота от @BotFather, пример: 123456789:AA...
TELEGRAM_BOT_TOKEN=123456789:AA_REPLACE_ME

# Секрет для внутренних API (`x-telegram-bot-secret`), должен совпадать с сервером (корневой `.env.local`).
TELEGRAM_BOT_SECRET=your_strong_internal_secret_here

# Базовый URL приложения для вызова internal API.
TELEGRAM_APP_BASE_URL=http://127.0.0.1:3000

# Явная карта `employeeId -> chatId`, пример: {"emp_123":"123456789","emp_456":"987654321"}.
# Если оставить `{}`, бот возьмет привязки из поля `Telegram Chat ID` в вебе (`/employees`).
TELEGRAM_EMPLOYEE_CHAT_MAP_JSON={}

# Chat ID администраторов для критичных алертов и ежедневного отчета, через запятую.
# Пример: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=

# Интервал сканирования событий (секунды).
TELEGRAM_SCAN_INTERVAL_SEC=30

# Таймаут long polling Telegram API (секунды).
TELEGRAM_API_TIMEOUT_SEC=50

# Часовой пояс для ежедневных отчетов.
TELEGRAM_TIMEZONE=Europe/Moscow

