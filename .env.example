# Хранилище. На проде ТОЛЬКО postgres — и в рантайме, и при `npm run build`
# (без него сборка линкуется с JSON-адаптером и читает замороженные файлы).
# json — только для локальной разработки без базы (src/lib/data-loader.ts).
DATA_SOURCE=postgres
DATABASE_URL=postgresql://carwash_app:password@localhost:5432/carwash

# Секрет для подписи cookie (ОБЯЗАТЕЛЬНО задать в продакшене!)
# Без него кука подписывается ключом по умолчанию из этого публичного репозитория,
# и любой может подписать себе роль admin. Сгенерировать: openssl rand -hex 32
COOKIE_SECRET=change-this-to-a-random-64-char-string

# Gemini API Key (Genkit, AI-отчёт на /reports). Используется только на сервере,
# префикс NEXT_PUBLIC_ исторический — в клиентский код значение не передавать.
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Дашборд камер (FastAPI на машине с камерами)
CAMERA_DASHBOARD_BASE_URL=http://192.168.1.59:8050

# GLM 4.7 API Key (для AI Assistant)
# Получить можно здесь: https://api.z.ai или https://open.bigmodel.cn
GLM_API_KEY=your_glm_api_key_here

# Phase 61 / АРХ-5: master key для шифрования AI-секретов в SQLite (data/ai-assistant.db).
# Сгенерировать: openssl rand -hex 32
# Формат: 32 байта в hex (64 hex-символа) ИЛИ base64 (~44 символа).
# Без этой переменной секреты пишутся в SQLite plain text (как было до Phase 61) + warning в логи.
# После выставления — рестарт сервиса + POST /api/admin/encrypt-secrets для миграции существующих значений.
# См. src/lib/crypto/README.md для подробностей.
AI_KEY_ENCRYPTION_SECRET=

# Telegram Bot (employee)
# Рекомендуемый локальный файл для worker: telegram-bot/.env.local
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_EMPLOYEE_CHAT_MAP_JSON={"emp_123":"123456789"}
TELEGRAM_ADMIN_CHAT_IDS=123456789
TELEGRAM_BOT_SECRET=your_strong_internal_secret_here
TELEGRAM_SCAN_INTERVAL_SEC=30
TELEGRAM_API_TIMEOUT_SEC=50
TELEGRAM_TIMEZONE=Europe/Moscow
TELEGRAM_APP_BASE_URL=http://127.0.0.1:3000
TELEGRAM_WEBAPP_SESSION_TTL_SEC=120
